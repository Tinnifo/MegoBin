Bootstrap: docker
From: nvcr.io/nvidia/pytorch:23.04-py3

%labels
    Author Tinni Freyr
    Project metagenomic-binning

%post
    # System deps
    apt-get update && apt-get install -y --no-install-recommends \
        bedtools hmmer prodigal && \
    rm -rf /var/lib/apt/lists/*

    # Python deps (pip into the container's base env)
    pip install --no-cache-dir \
        hydra-core>=1.3 omegaconf \
        wandb dvc \
        scikit-learn>=1.2 pandas>=2.0 scipy>=1.10 \
        python-igraph>=0.11 leidenalg infomap \
        pytest pytest-cov black ruff

    # CheckM2 + DIAMOND (bioconda packages via pip if not available)
    pip install --no-cache-dir checkm2

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec python "$@"
